NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ASSEMBLY_EXPORT_API_URL=
ASSEMBLY_EXPORT_TOKEN=
HUB_ASSEMBLY_SYNC_TOKEN=
ASSEMBLY_LEAVE_APPLY_URL=
HUB_TO_ASSEMBLY_TOKEN=
KMA_APIHUB_AUTH_KEY=
VERCEL_USAGE_DEBUG=false

# 임시 비밀번호(비밀번호 찾기) 메일 발송용 SMTP 설정
# SMTP_SECURE는 반드시 문자열 "true"/"false"로 설정 (465 포트=true, 587/25=false)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# MAIL_LOG_ONLY=true면 메일을 실제로 보내지 않고 서버 로그만 남기며,
# 비밀번호 찾기 API는 실패를 반환한다. 운영(프로덕션)에서는 반드시 제거하거나 false로 둘 것.
MAIL_LOG_ONLY=false
