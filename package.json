{
  "name": "j-special-force-portal",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "debug:rebalance": "ts-node --project scripts/tsconfig.debug.json -r tsconfig-paths/register scripts/replay-rebalance.ts",
    "test:e2e": "playwright test",
    "harness:routes": "node scripts/harness/generate-route-map.mjs",
    "harness:env": "node scripts/harness/generate-env-map.mjs",
    "harness:supabase": "node scripts/harness/generate-supabase-map.mjs",
    "harness:scripts": "node scripts/harness/generate-package-scripts.mjs",
    "harness:generate": "npm run harness:routes && npm run harness:env && npm run harness:supabase && npm run harness:scripts",
    "harness:docs": "node scripts/harness/check-doc-links.mjs && node scripts/harness/check-generated-freshness.mjs",
    "harness:boundaries": "node scripts/harness/check-boundaries.mjs",
    "harness:quality": "node scripts/harness/quality-score.mjs",
    "harness:all": "node scripts/harness/run-harness.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "motion": "^12.38.0",
    "next": "^15.0.0",
    "nodemailer": "^8.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  }
}
